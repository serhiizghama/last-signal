PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API with the session cookie.
# Unset falls back to the Vite dev server. In production set it to the public origin the
# web bundle is served from. A wildcard is not supported — credentialed requests reject it.
CORS_ORIGINS=http://localhost:5173

# Single-node replica set (required for multi-document transactions).
# `docker compose up -d` from the repo root starts this on host port 27117.
MONGODB_URI=mongodb://localhost:27117/last-signal?replicaSet=rs0&directConnection=true

# Event scheduler worker (build completions, etc.). Set to false to construct
# the app without the background poll loop, e.g. in a one-off script.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_LEASE_TIMEOUT_MS=60000
SCHEDULER_MAX_ATTEMPTS=3

# Number of inert NPC accounts + settlements NpcSeederService seeds once at world start
# (M2a.5). Set to 0 to disable seeding entirely — every integration spec that boots the whole
# app does this so its settlement-count assertions stay exact and fast.
WORLD_NPC_COUNT=135
